# PostgreSQL connection string. Supabase works well.
# For Supabase serverless deployments, use the transaction pooler URL when available.
DATABASE_URL="postgresql://postgres:password@localhost:5432/taskflow?schema=public"

# Optional. Use a direct database URL for migrations if your production DATABASE_URL is pooled.
DIRECT_URL="postgresql://postgres:password@localhost:5432/taskflow?schema=public"

# Secret key used for signing session JWT tokens (minimum 32 characters)
SESSION_SECRET="taskflow-super-secure-production-session-secret-key-32-chars-minimum"
